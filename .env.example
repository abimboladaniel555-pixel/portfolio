# Add these 5 in Vercel -> Settings -> Environment Variables
# (and in a local .env.local file if you run `npx vercel dev`). NEVER commit .env.local.
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key
RESEND_API_KEY=re_xxxxxxxxxxxx
MY_EMAIL=the-email-you-signed-up-to-resend-with
ADMIN_PASSWORD=a-long-unique-password-only-you-know
